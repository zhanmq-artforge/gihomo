<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gihomo">
  <schema id="art.artforge.Gihomo" path="/art/artforge/Gihomo/">
    <key name="window-width" type="i">
      <default>1020</default>
      <summary>Default window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>700</default>
      <summary>Default window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="controller-api" type="s">
      <default>'http://127.0.0.1:9090'</default>
      <summary>Mihomo external controller URL</summary>
    </key>
    <key name="controller-secret" type="s">
      <default>''</default>
      <summary>Mihomo external controller secret</summary>
    </key>
    <key name="mixed-port" type="i">
      <default>7890</default>
      <summary>Mihomo mixed port for HTTP/SOCKS5</summary>
    </key>
    <key name="kernel-path" type="s">
      <default>''</default>
      <summary>Custom Mihomo kernel binary path</summary>
    </key>
    <key name="auto-update-subscriptions" type="b">
      <default>true</default>
      <summary>Automatically update subscriptions periodically</summary>
    </key>
    <key name="update-interval-hours" type="i">
      <default>24</default>
      <summary>Subscription update interval in hours</summary>
    </key>
  </schema>
</schemalist>
